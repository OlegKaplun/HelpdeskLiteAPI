{
    "openapi": "3.0.0",
    "info": {
        "title": "HelpdeskLiteAPI",
        "description": "Internal support tickets API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/tickets": {
            "get": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Получить список заявок (фильтры + пагинация)",
                "operationId": "b406702bcd80642f4b5c83c1bf20105b",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "new",
                                "in_progress",
                                "done",
                                "closed"
                            ]
                        }
                    },
                    {
                        "name": "q",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 20
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "example": "-created_at"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Cписок заявок успешно получен"
                    }
                },
                "security": [
                    {
                        "apiKey": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Создать заявку",
                "operationId": "80fbef860b264eed3bc3ccd90d8ddc8b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "title",
                                    "description",
                                    "author_email"
                                ],
                                "properties": {
                                    "title": {
                                        "type": "string",
                                        "example": "Не работает отчёт"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "При открытии 500 ошибка"
                                    },
                                    "author_email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@company.local"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Заявка успешно создана",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Ошибка валидации"
                    }
                },
                "security": [
                    {
                        "apiKey": []
                    }
                ]
            }
        },
        "/api/v1/tickets/{id}": {
            "get": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Получить карточку заявки + комментарии",
                "operationId": "596302276f442d583400ce2abf22cb00",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Заявка получена"
                    },
                    "404": {
                        "description": "Заявка не найдена"
                    }
                },
                "security": [
                    {
                        "apiKey": []
                    }
                ]
            }
        },
        "/api/v1/tickets/{id}/events": {
            "post": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Добавить комментарий и (опционально) сменить статус — в одной транзакции",
                "operationId": "e35abdca9fa68961d3ca3ee103c6420a",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Комментарий добавлен"
                    },
                    "409": {
                        "description": "Конфликт версий"
                    }
                },
                "security": [
                    {
                        "apiKey": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "apiKey": {
                "type": "apiKey",
                "description": "API Key Authentication",
                "name": "X-API-Key",
                "in": "header"
            }
        }
    },
    "tags": [
        {
            "name": "Tickets",
            "description": "Tickets"
        }
    ]
}